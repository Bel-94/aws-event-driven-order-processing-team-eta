{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/order-placed.schema.json",
  "title": "OrderPlaced",
  "description": "Detail payload published to EventBridge after an order is written to DynamoDB.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderId",
    "customerId",
    "items",
    "status",
    "totalAmount",
    "currency",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "pattern": "^ord_.+",
      "description": "Order partition key generated by Order Intake."
    },
    "customerId": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "quantity", "unitPrice"],
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "productName": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "number", "exclusiveMinimum": 0 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
        }
      }
    },
    "status": {
      "type": "string",
      "const": "PENDING"
    },
    "totalAmount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
